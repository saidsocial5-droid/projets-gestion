# Local: values printed by `npx supabase status`
# Production: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never NEXT_PUBLIC): background jobs
SUPABASE_SECRET_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Email: Resend in production (https://resend.com), Mailpit locally
RESEND_API_KEY=
MAIL_FROM=AFMI <noreply@your-domain.ma>
MAILPIT_URL=http://127.0.0.1:54324
