# Local: values printed by `npx supabase status`
# Production: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never NEXT_PUBLIC): background jobs
SUPABASE_SECRET_KEY=
# The daily GitHub Actions workflow sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Email — set ONE of these (all free):
#   a) Resend (needs the association's domain)
RESEND_API_KEY=
#   b) any SMTP server, e.g. a Gmail account with an app password (no domain needed)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#   c) local development: Mailpit from `supabase start`
MAILPIT_URL=http://127.0.0.1:54324
MAIL_FROM=AFMI <noreply@your-domain.ma>
