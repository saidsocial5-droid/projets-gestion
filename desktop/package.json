{
  "name": "afmi-projets-desktop",
  "productName": "AFMI Projets",
  "version": "1.0.0",
  "description": "منصة مشاريع AFMI — تطبيق سطح المكتب",
  "author": "AFMI",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "ma.afmi.projets",
    "productName": "AFMI Projets",
    "copyright": "AFMI",
    "files": [
      "main.js",
      "preload.js",
      "pages/**",
      "app-config.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "AFMI-Projets-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AFMI Projets"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "AFMI-Projets-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "AFMI-Projets-${version}.${ext}"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12"
  }
}
